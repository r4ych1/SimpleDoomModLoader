<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="ModLoader.App.MainWindow"
        Width="1180"
        Height="820"
        Title="ModLoader - Feature 010">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#f8fafc" />
          <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#94a3b8" />
          <SolidColorBrush x:Key="DropZoneDragOverBackgroundBrush" Color="#e0f2fe" />
          <SolidColorBrush x:Key="DropZoneDragOverBorderBrush" Color="#2563eb" />
          <SolidColorBrush x:Key="DropZoneFocusBorderBrush" Color="#1d4ed8" />
          <SolidColorBrush x:Key="DropZoneTitleForegroundBrush" Color="#0f172a" />
          <SolidColorBrush x:Key="DropZoneHelperForegroundBrush" Color="#334155" />
          <SolidColorBrush x:Key="DropZoneIconBackgroundBrush" Color="#dbeafe" />
          <SolidColorBrush x:Key="DropZoneIconBorderBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="DropZoneIconForegroundBrush" Color="#1d4ed8" />
          <SolidColorBrush x:Key="InputRowHoverBackgroundBrush" Color="#12000000" />
          <SolidColorBrush x:Key="InputRowHoverBorderBrush" Color="#40000000" />
          <SolidColorBrush x:Key="InputRowSelectedBackgroundBrush" Color="#2a3b82f6" />
          <SolidColorBrush x:Key="InputRowSelectedBorderBrush" Color="#3b82f6" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBackgroundBrush" Color="#3d2563eb" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBorderBrush" Color="#1d4ed8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#172033" />
          <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#64748b" />
          <SolidColorBrush x:Key="DropZoneDragOverBackgroundBrush" Color="#1d3152" />
          <SolidColorBrush x:Key="DropZoneDragOverBorderBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="DropZoneFocusBorderBrush" Color="#93c5fd" />
          <SolidColorBrush x:Key="DropZoneTitleForegroundBrush" Color="#e5e7eb" />
          <SolidColorBrush x:Key="DropZoneHelperForegroundBrush" Color="#cbd5e1" />
          <SolidColorBrush x:Key="DropZoneIconBackgroundBrush" Color="#10233f" />
          <SolidColorBrush x:Key="DropZoneIconBorderBrush" Color="#3b82f6" />
          <SolidColorBrush x:Key="DropZoneIconForegroundBrush" Color="#93c5fd" />
          <SolidColorBrush x:Key="InputRowHoverBackgroundBrush" Color="#1f93c5fd" />
          <SolidColorBrush x:Key="InputRowHoverBorderBrush" Color="#4b93c5fd" />
          <SolidColorBrush x:Key="InputRowSelectedBackgroundBrush" Color="#334f8df5" />
          <SolidColorBrush x:Key="InputRowSelectedBorderBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBackgroundBrush" Color="#4464a7ff" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBorderBrush" Color="#93c5fd" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.DropZone">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource DropZoneBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource DropZoneBackgroundBrush}" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.DropZone:focus">
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource DropZoneFocusBorderBrush}" />
    </Style>
    <Style Selector="Border.DropZone.dragover">
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource DropZoneDragOverBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource DropZoneDragOverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.InputRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.InputRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputRowHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputRowHoverBorderBrush}" />
    </Style>
    <Style Selector="Border.InputRow.selected">
      <Setter Property="Background" Value="{DynamicResource InputRowSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputRowSelectedBorderBrush}" />
    </Style>
    <Style Selector="Border.InputRow.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputRowSelectedHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputRowSelectedHoverBorderBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top"
            BorderThickness="0,0,0,1"
            BorderBrush="#374151"
            Background="#0b1220"
            Padding="12,10">
      <StackPanel Spacing="2">
        <TextBlock FontSize="20"
                   FontWeight="Bold"
                   Foreground="#e5e7eb"
                   Text="Feature 010: Profile Drag Reorder" />
        <TextBlock Foreground="#9ca3af"
                   Text="Profiles are the only launchable unit. Select a profile on the left, then manage Source Port, IWAD, and Mods from the shared library on the right." />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasMessage}"
            BorderBrush="#f59e0b"
            BorderThickness="1"
            Background="#1af59e0b"
            Padding="10"
            Margin="20,12,20,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Foreground="#92400e"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Text="{Binding MessageText}" />
        <Button Grid.Column="1"
                Content="Delete"
                IsVisible="{Binding HasPendingDeleteConfirmation}"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="OnConfirmDeleteProfileClicked" />
        <Button Grid.Column="2"
                Content="Cancel"
                IsVisible="{Binding HasPendingDeleteConfirmation}"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="OnCancelDeleteProfileClicked" />
      </Grid>
    </Border>

    <Grid Margin="20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding ProfilePaneColumnWidth}" />
        <ColumnDefinition Width="{Binding PaneSpacerColumnWidth}" />
        <ColumnDefinition Width="{Binding FileLibraryPaneColumnWidth}" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              BorderBrush="#374151"
              BorderThickness="1"
              CornerRadius="8"
              Background="#0f172a"
              Padding="12">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#e5e7eb"
                       VerticalAlignment="Center"
                       Text="Profiles" />
            <Button Grid.Row="0"
                    Grid.Column="1"
                    Content="New Profile"
                    HorizontalAlignment="Right"
                    Click="OnNewProfileClicked" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Content="{Binding FileLibraryPaneToggleText}"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"
                    Click="OnToggleFileLibraryPaneCollapsedClicked" />
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Foreground="#94a3b8"
                       Margin="0,2,0,0"
                       Text="Select, launch, or delete a launch profile from the saved profile list." />
          </Grid>

          <Grid Grid.Row="1"
                x:Name="ProfileListHost"
                Margin="0,12,0,0"
                ClipToBounds="True">
            <ScrollViewer x:Name="ProfileListScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ProfileRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="InputRow"
                            Classes.selected="{Binding IsSelected}"
                            Margin="0,0,0,8"
                            Tag="{Binding Id}"
                            PointerPressed="OnProfileRowPointerPressed"
                            PointerMoved="OnProfileRowPointerMoved"
                            PointerReleased="OnProfileRowPointerReleased"
                            PointerCaptureLost="OnProfileRowPointerCaptureLost">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6">
                          <TextBlock IsVisible="{Binding IsDisplayVisible}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     MaxLines="2"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Name}" />
                          <TextBox IsVisible="{Binding IsRenameVisible}"
                                   Tag="{Binding Id}"
                                   Text="{Binding DataContext.SelectedProfileRenameText, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                   KeyDown="OnProfileRenameKeyDown"
                                   LostFocus="OnProfileRenameLostFocus"
                                   Loaded="OnProfileRenameTextBoxLoaded" />
                          <TextBlock IsVisible="{Binding IsCommandPreviewVisible}"
                                     Foreground="#94a3b8"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     Text="{Binding CommandPreviewText}" />
                          <TextBlock IsVisible="{Binding IsInvalidReasonVisible}"
                                     Foreground="#f59e0b"
                                     TextWrapping="Wrap"
                                     Text="{Binding InvalidReason}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="6"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top">
                          <Border IsVisible="{Binding HasStatusBadge}"
                                  Background="{Binding StatusBadgeBackground}"
                                  CornerRadius="999"
                                  Padding="8,2">
                            <TextBlock Foreground="{Binding StatusBadgeForeground}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Text="{Binding StatusBadgeText}" />
                          </Border>
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      IsVisible="{Binding IsDisplayVisible}"
                                      HorizontalAlignment="Right">
                            <Button Content="Launch"
                                    Tag="{Binding Id}"
                                    IsEnabled="{Binding CanLaunchProfile}"
                                    Click="OnLaunchProfileClicked" />
                            <Button Content="Rename"
                                    Tag="{Binding Id}"
                                    Click="OnRenameProfileClicked" />
                            <Button Content="Delete"
                                    Tag="{Binding Id}"
                                    Click="OnDeleteProfileClicked" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Canvas IsHitTestVisible="False">
              <Border IsVisible="{Binding IsProfileDropIndicatorVisible}"
                      Canvas.Left="{Binding ProfileDropIndicatorLeft}"
                      Canvas.Top="{Binding ProfileDropIndicatorTop}"
                      Width="{Binding ProfileDropIndicatorWidth}"
                      Height="2"
                      Background="#60a5fa" />
              <Border IsVisible="{Binding IsProfileDragGhostVisible}"
                      Canvas.Left="{Binding ProfileDragGhostLeft}"
                      Canvas.Top="{Binding ProfileDragGhostTop}"
                      Background="#111827"
                      BorderBrush="#60a5fa"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12,8"
                      Opacity="0.96">
                <TextBlock Foreground="#e5e7eb"
                           FontWeight="SemiBold"
                           Text="{Binding ProfileDragGhostText}" />
              </Border>
            </Canvas>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2"
              IsVisible="{Binding IsFileLibraryPaneExpanded}"
              BorderBrush="#374151"
              BorderThickness="1"
              CornerRadius="8"
              Background="#0f172a"
              Padding="12">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0"
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="#e5e7eb"
                     VerticalAlignment="Center"
                     Text="File Library" />

          <ScrollViewer Grid.Row="1"
                        Margin="0,12,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
              <Border BorderBrush="#374151"
                      BorderThickness="1"
                      CornerRadius="8"
                      Background="#111827"
                      Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock FontSize="18"
                             FontWeight="Bold"
                             Foreground="#e5e7eb"
                             Text="{Binding SelectedProfileName}" />
                  <TextBlock Foreground="{Binding SelectedProfileStatusForeground}"
                             TextWrapping="Wrap"
                             Text="{Binding SelectedProfileStatusText}" />
                  <TextBlock IsVisible="{Binding HasSelectedProfileCommandPreview}"
                             Foreground="#94a3b8"
                             FontFamily="Consolas"
                             TextWrapping="Wrap"
                             Text="{Binding SelectedProfileCommandPreviewText}" />
                </StackPanel>
              </Border>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Text="Source Port Inputs" />
                  <Button Grid.Column="1"
                          Content="{Binding SourcePortSectionToggleText}"
                          Click="OnToggleSourcePortSectionCollapsedClicked" />
                </Grid>
                <Border Classes="DropZone"
                        Classes.dragover="{Binding IsSourcePortDropZoneDragActive}"
                        IsVisible="{Binding AreSourcePortRowsVisible}"
                        Tag="SourcePort"
                        Focusable="True"
                        IsTabStop="True"
                        PointerPressed="OnDropZonePointerPressed"
                        KeyDown="OnDropZoneKeyDown"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnDropZoneDragEnter"
                        DragDrop.DragLeave="OnDropZoneDragLeave"
                        DragDrop.DragOver="OnDropZoneDragOver"
                        automation:AutomationProperties.Name="Source Port drop zone. Drag files here or click to upload."
                        automation:AutomationProperties.HelpText="Allowed: .exe. Drop one or more files. Directories are ignored."
                        DragDrop.Drop="OnSourcePortDrop">
                  <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                      <TextBlock Foreground="{DynamicResource DropZoneTitleForegroundBrush}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Text="Drag and drop here" />
                      <TextBlock Foreground="{DynamicResource DropZoneHelperForegroundBrush}"
                                 TextWrapping="Wrap"
                                 Text="Allowed: .exe. Drop one or more files. Directories are ignored." />
                    </StackPanel>
                    <ItemsControl Grid.Row="1"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding SourcePortRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="InputRow"
                                  Classes.selected="{Binding IsSelected}"
                                  Margin="0,4,0,0"
                                  Tag="{Binding Path}"
                                  PointerPressed="OnSourcePortRowPointerPressed">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="SourcePortActionColumn" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0"
                                         Text="{Binding Path}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="Remove"
                                      Tag="{Binding Path}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Click="OnRemoveSourcePortClicked" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Text="IWAD Inputs" />
                  <Button Grid.Column="1"
                          Content="{Binding IwadSectionToggleText}"
                          Click="OnToggleIwadSectionCollapsedClicked" />
                </Grid>
                <Border Classes="DropZone"
                        Classes.dragover="{Binding IsIwadDropZoneDragActive}"
                        IsVisible="{Binding AreIwadRowsVisible}"
                        Tag="Iwad"
                        Focusable="True"
                        IsTabStop="True"
                        PointerPressed="OnDropZonePointerPressed"
                        KeyDown="OnDropZoneKeyDown"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnDropZoneDragEnter"
                        DragDrop.DragLeave="OnDropZoneDragLeave"
                        DragDrop.DragOver="OnDropZoneDragOver"
                        automation:AutomationProperties.Name="IWAD drop zone. Drag files here or click to upload."
                        automation:AutomationProperties.HelpText="Allowed: .wad, .pk3, .iwad, .ipk3, .ipk7, .pk7. Directories scan top-level files only."
                        DragDrop.Drop="OnIwadDrop">
                  <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                      <TextBlock Foreground="{DynamicResource DropZoneTitleForegroundBrush}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Text="Drag and drop here" />
                      <TextBlock Foreground="{DynamicResource DropZoneHelperForegroundBrush}"
                                 TextWrapping="Wrap"
                                 Text="Allowed: .wad, .pk3, .iwad, .ipk3, .ipk7, .pk7. Directories scan top-level files only." />
                    </StackPanel>
                    <ItemsControl Grid.Row="1"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding IwadRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="InputRow"
                                  Classes.selected="{Binding IsSelected}"
                                  Margin="0,4,0,0"
                                  Tag="{Binding Path}"
                                  PointerPressed="OnIwadRowPointerPressed">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="IwadActionColumn" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0"
                                         Text="{Binding Path}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="Remove"
                                      Tag="{Binding Path}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Click="OnRemoveIwadClicked" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </StackPanel>

              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Text="Mod Inputs" />
                  <Button Grid.Column="1"
                          Content="{Binding ModSectionToggleText}"
                          Click="OnToggleModSectionCollapsedClicked" />
                </Grid>
                <Border Classes="DropZone"
                        Classes.dragover="{Binding IsModDropZoneDragActive}"
                        IsVisible="{Binding AreModRowsVisible}"
                        Tag="Mod"
                        Focusable="True"
                        IsTabStop="True"
                        PointerPressed="OnDropZonePointerPressed"
                        KeyDown="OnDropZoneKeyDown"
                        DragDrop.AllowDrop="True"
                        DragDrop.DragEnter="OnDropZoneDragEnter"
                        DragDrop.DragLeave="OnDropZoneDragLeave"
                        DragDrop.DragOver="OnDropZoneDragOver"
                        automation:AutomationProperties.Name="Mod drop zone. Drag files here or click to upload."
                        automation:AutomationProperties.HelpText="Allowed: .wad, .pwad, .pk3, .pk7, .ipk3, .ipk7, .pkz, .zip. Directories scan top-level files only."
                        DragDrop.Drop="OnModDrop">
                  <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Spacing="2">
                      <TextBlock Foreground="{DynamicResource DropZoneTitleForegroundBrush}"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Text="Drag and drop here" />
                      <TextBlock Foreground="{DynamicResource DropZoneHelperForegroundBrush}"
                                 TextWrapping="Wrap"
                                 Text="Allowed: .wad, .pwad, .pk3, .pk7, .ipk3, .ipk7, .pkz, .zip. Directories scan top-level files only." />
                    </StackPanel>
                    <ItemsControl Grid.Row="1"
                                  Margin="0,12,0,0"
                                  ItemsSource="{Binding ModRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="InputRow"
                                  Classes.selected="{Binding IsSelected}"
                                  Margin="0,4,0,0"
                                  Tag="{Binding Path}"
                                  PointerPressed="OnModRowPointerPressed">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ModActionColumn" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Grid.Column="0"
                                         Text="{Binding Path}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <Button Grid.Column="1"
                                      Content="Remove"
                                      Tag="{Binding Path}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Click="OnRemoveModClicked" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
