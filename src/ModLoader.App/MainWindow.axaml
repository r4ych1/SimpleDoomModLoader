<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
        x:Class="ModLoader.App.MainWindow"
        Title="Simple Doom Mod Loader">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#f8fafc" />
          <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#94a3b8" />
          <SolidColorBrush x:Key="DropZoneDragOverBackgroundBrush" Color="#e0f2fe" />
          <SolidColorBrush x:Key="DropZoneDragOverBorderBrush" Color="#2563eb" />
          <SolidColorBrush x:Key="DropZoneFocusBorderBrush" Color="#1d4ed8" />
          <SolidColorBrush x:Key="DropZoneTitleForegroundBrush" Color="#0f172a" />
          <SolidColorBrush x:Key="DropZoneHelperForegroundBrush" Color="#334155" />
          <SolidColorBrush x:Key="DropZoneIconBackgroundBrush" Color="#dbeafe" />
          <SolidColorBrush x:Key="DropZoneIconBorderBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="DropZoneIconForegroundBrush" Color="#1d4ed8" />
          <SolidColorBrush x:Key="InputRowHoverBackgroundBrush" Color="#12000000" />
          <SolidColorBrush x:Key="InputRowHoverBorderBrush" Color="#40000000" />
          <SolidColorBrush x:Key="InputRowSelectedBackgroundBrush" Color="#2a3b82f6" />
          <SolidColorBrush x:Key="InputRowSelectedBorderBrush" Color="#3b82f6" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBackgroundBrush" Color="#3d2563eb" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBorderBrush" Color="#1d4ed8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DropZoneBackgroundBrush" Color="#172033" />
          <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#64748b" />
          <SolidColorBrush x:Key="DropZoneDragOverBackgroundBrush" Color="#1d3152" />
          <SolidColorBrush x:Key="DropZoneDragOverBorderBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="DropZoneFocusBorderBrush" Color="#93c5fd" />
          <SolidColorBrush x:Key="DropZoneTitleForegroundBrush" Color="#e5e7eb" />
          <SolidColorBrush x:Key="DropZoneHelperForegroundBrush" Color="#cbd5e1" />
          <SolidColorBrush x:Key="DropZoneIconBackgroundBrush" Color="#10233f" />
          <SolidColorBrush x:Key="DropZoneIconBorderBrush" Color="#3b82f6" />
          <SolidColorBrush x:Key="DropZoneIconForegroundBrush" Color="#93c5fd" />
          <SolidColorBrush x:Key="InputRowHoverBackgroundBrush" Color="#1f93c5fd" />
          <SolidColorBrush x:Key="InputRowHoverBorderBrush" Color="#4b93c5fd" />
          <SolidColorBrush x:Key="InputRowSelectedBackgroundBrush" Color="#334f8df5" />
          <SolidColorBrush x:Key="InputRowSelectedBorderBrush" Color="#60a5fa" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBackgroundBrush" Color="#4464a7ff" />
          <SolidColorBrush x:Key="InputRowSelectedHoverBorderBrush" Color="#93c5fd" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="add_square_regular">M12 7C12.4142 7 12.75 7.33579 12.75 7.75V11.25H16.25C16.6642 11.25 17 11.5858 17 12C17 12.4142 16.6642 12.75 16.25 12.75H12.75V16.25C12.75 16.6642 12.4142 17 12 17C11.5858 17 11.25 16.6642 11.25 16.25V12.75H7.75C7.33579 12.75 7 12.4142 7 12C7 11.5858 7.33579 11.25 7.75 11.25H11.25V7.75C11.25 7.33579 11.5858 7 12 7Z M3 6.25C3 4.45507 4.45507 3 6.25 3H17.75C19.5449 3 21 4.45507 21 6.25V17.75C21 19.5449 19.5449 21 17.75 21H6.25C4.45507 21 3 19.5449 3 17.75V6.25ZM6.25 4.5C5.2835 4.5 4.5 5.2835 4.5 6.25V17.75C4.5 18.7165 5.2835 19.5 6.25 19.5H17.75C18.7165 19.5 19.5 18.7165 19.5 17.75V6.25C19.5 5.2835 18.7165 4.5 17.75 4.5H6.25Z</StreamGeometry>
      <StreamGeometry x:Key="delete_regular">M5 5.25C5 4.00736 6.00736 3 7.25 3H16.75C17.9926 3 19 4.00736 19 5.25V6H21.25C21.6642 6 22 6.33579 22 6.75C22 7.16421 21.6642 7.5 21.25 7.5H20.682L19.9324 18.3653C19.8485 19.5813 18.8372 20.525 17.6182 20.525H6.38178C5.1628 20.525 4.1515 19.5813 4.0676 18.3653L3.31802 7.5H2.75C2.33579 7.5 2 7.16421 2 6.75C2 6.33579 2.33579 6 2.75 6H5V5.25ZM6.5 6H17.5V5.25C17.5 4.83579 17.1642 4.5 16.75 4.5H7.25C6.83579 4.5 6.5 4.83579 6.5 5.25V6ZM4.82179 7.5L5.56429 18.2665C5.59226 18.672 5.92936 18.9863 6.33577 18.9863H17.6642C18.0706 18.9863 18.4077 18.672 18.4357 18.2665L19.1782 7.5H4.82179ZM9.75 10.25C10.1642 10.25 10.5 10.5858 10.5 11V15.25C10.5 15.6642 10.1642 16 9.75 16C9.33579 16 9 15.6642 9 15.25V11C9 10.5858 9.33579 10.25 9.75 10.25ZM14.25 10.25C14.6642 10.25 15 10.5858 15 11V15.25C15 15.6642 14.6642 16 14.25 16C13.8358 16 13.5 15.6642 13.5 15.25V11C13.5 10.5858 13.8358 10.25 14.25 10.25Z</StreamGeometry>
      <StreamGeometry x:Key="edit_regular">M16.8625 3.48706C17.9844 2.36519 19.8032 2.36519 20.9251 3.48706C22.047 4.60893 22.047 6.42779 20.9251 7.54966L8.52576 19.949C8.09371 20.3811 7.55149 20.6867 6.95785 20.833L3.87941 21.5915C3.09296 21.7852 2.37697 21.0692 2.57065 20.2828L3.32918 17.2043C3.47546 16.6107 3.78105 16.0685 4.2131 15.6364L16.8625 3.48706ZM19.8644 4.54772C19.3285 4.01183 18.4591 4.01183 17.9232 4.54772L17.0503 5.42059L18.9916 7.36193L19.8644 6.489C20.4003 5.9531 20.4003 5.08362 19.8644 4.54772ZM17.9309 8.42259L15.9896 6.48125L5.27376 17.1971C5.03373 17.4371 4.86396 17.7383 4.78269 18.0679L4.23206 20.3024L6.46651 19.7517C6.79613 19.6705 7.0973 19.5007 7.33734 19.2607L17.9309 8.66714V8.42259Z</StreamGeometry>
      <StreamGeometry x:Key="play_regular">M8.56215 5.21846C7.56191 4.6092 6.28711 5.32844 6.28711 6.49964V17.5004C6.28711 18.6716 7.56191 19.3908 8.56215 18.7815L17.5937 13.2812C18.5629 12.6911 18.5629 11.3089 17.5937 10.7188L8.56215 5.21846ZM7.78711 6.49964C7.78711 6.10823 8.21271 5.86849 8.54612 6.07157L17.5777 11.5719C17.9008 11.7686 17.9008 12.2314 17.5777 12.4281L8.54612 17.9284C8.21271 18.1315 7.78711 17.8918 7.78711 17.5004V6.49964Z</StreamGeometry>
      <StreamGeometry x:Key="folder_regular">M5.75 5C4.50736 5 3.5 6.00736 3.5 7.25V16.75C3.5 17.9926 4.50736 19 5.75 19H18.25C19.4926 19 20.5 17.9926 20.5 16.75V9.75C20.5 8.50736 19.4926 7.5 18.25 7.5H11.5607C11.3549 7.5 11.1551 7.42953 10.9945 7.30031L8.25546 5.09969C8.09487 4.97047 7.89508 4.9 7.6893 4.9L5.75 5ZM5 7.25C5 6.83579 5.33579 6.5 5.75 6.5H7.42385L10.0565 8.6164C10.4857 8.96104 11.0195 9.15 11.5699 9.15H18.25C18.6642 9.15 19 9.48579 19 9.9V16.75C19 17.1642 18.6642 17.5 18.25 17.5H5.75C5.33579 17.5 5 17.1642 5 16.75V7.25Z</StreamGeometry>
      <StreamGeometry x:Key="folder_open_regular">M20 9.50195V8.74985C20 7.50721 18.9926 6.49985 17.75 6.49985H12.0247L9.64368 4.51995C9.23959 4.18393 8.73063 3.99997 8.20509 3.99997H4.24957C3.00724 3.99997 2 5.00686 1.99957 6.24919L1.99561 17.7492C1.99518 18.9921 3.00266 20 4.24561 20H4.27196C4.27607 20 4.28019 20 4.28431 20H18.4693C19.2723 20 19.9723 19.4535 20.167 18.6745L21.9169 11.6765C22.1931 10.5719 21.3577 9.50195 20.2192 9.50195H20ZM4.24957 5.49997H8.20509C8.38027 5.49997 8.54993 5.56129 8.68462 5.6733L11.2741 7.82652C11.4088 7.93852 11.5784 7.99985 11.7536 7.99985H17.75C18.1642 7.99985 18.5 8.33563 18.5 8.74985V9.50195H6.42385C5.39136 9.50195 4.49137 10.2047 4.241 11.2064L3.49684 14.1837L3.49957 6.24971C3.49971 5.8356 3.83546 5.49997 4.24957 5.49997ZM5.69623 11.5701C5.77969 11.2362 6.07969 11.002 6.42385 11.002H20.2192C20.3819 11.002 20.5012 11.1548 20.4617 11.3126L18.7119 18.3107C18.684 18.4219 18.584 18.5 18.4693 18.5H4.28431C4.12167 18.5 4.00233 18.3472 4.04177 18.1894L5.69623 11.5701Z</StreamGeometry>
      <StreamGeometry x:Key="arrow_left_regular">M11.5303 7.46967C11.8232 7.76256 11.8232 8.23744 11.5303 8.53033L8.81066 11.25H16C16.4142 11.25 16.75 11.5858 16.75 12C16.75 12.4142 16.4142 12.75 16 12.75H8.81066L11.5303 15.4697C11.8232 15.7626 11.8232 16.2374 11.5303 16.5303C11.2374 16.8232 10.7626 16.8232 10.4697 16.5303L6.46967 12.5303C6.17678 12.2374 6.17678 11.7626 6.46967 11.4697L10.4697 7.46967C10.7626 7.17678 11.2374 7.17678 11.5303 7.46967Z</StreamGeometry>
      <StreamGeometry x:Key="arrow_right_regular">M12.4697 7.46967C12.7626 7.17678 13.2374 7.17678 13.5303 7.46967L17.5303 11.4697C17.8232 11.7626 17.8232 12.2374 17.5303 12.5303L13.5303 16.5303C13.2374 16.8232 12.7626 16.8232 12.4697 16.5303C12.1768 16.2374 12.1768 15.7626 12.4697 15.4697L15.1893 12.75H8C7.58579 12.75 7.25 12.4142 7.25 12C7.25 11.5858 7.58579 11.25 8 11.25H15.1893L12.4697 8.53033C12.1768 8.23744 12.1768 7.76256 12.4697 7.46967Z</StreamGeometry>
      <StreamGeometry x:Key="arrow_down_regular">M12.5303 16.5303C12.2374 16.8232 11.7626 16.8232 11.4697 16.5303L7.46967 12.5303C7.17678 12.2374 7.17678 11.7626 7.46967 11.4697C7.76256 11.1768 8.23744 11.1768 8.53033 11.4697L11.25 14.1893V8.5C11.25 8.08579 11.5858 7.75 12 7.75C12.4142 7.75 12.75 8.08579 12.75 8.5V14.1893L15.4697 11.4697C15.7626 11.1768 16.2374 11.1768 16.5303 11.4697C16.8232 11.7626 16.8232 12.2374 16.5303 12.5303L12.5303 16.5303Z</StreamGeometry>
      <StreamGeometry x:Key="chevron_up_regular">M39.6339 23.8839C40.122 23.3957 40.122 22.6043 39.6339 22.1161L24.8839 7.36612C24.3957 6.87796 23.6043 6.87796 23.1161 7.36612L8.36612 22.1161C7.87796 22.6043 7.87796 23.3957 8.36612 23.8839C8.85427 24.372 9.64573 24.372 10.1339 23.8839L24 10.0178L37.8661 23.8839C38.3543 24.372 39.1457 24.372 39.6339 23.8839Z</StreamGeometry>
      <StreamGeometry x:Key="chevron_down_regular">M8.36612 16.1161C7.87796 16.6043 7.87796 17.3957 8.36612 17.8839L23.1161 32.6339C23.6043 33.122 24.3957 33.122 24.8839 32.6339L39.6339 17.8839C40.122 17.3957 40.122 16.6043 39.6339 16.1161C39.1457 15.628 38.3543 15.628 37.8661 16.1161L24 29.9822L10.1339 16.1161C9.64573 15.628 8.85427 15.628 8.36612 16.1161Z</StreamGeometry>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.IconButton">
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ScrollViewer.HiddenScrollbars">
      <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="Border.DropZone">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderBrush" Value="{DynamicResource DropZoneBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource DropZoneBackgroundBrush}" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.DropZone.dragover">
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="BorderBrush" Value="{DynamicResource DropZoneDragOverBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource DropZoneDragOverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.InputRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.InputRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputRowHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputRowHoverBorderBrush}" />
    </Style>
    <Style Selector="Border.InputRow.selected">
      <Setter Property="Background" Value="{DynamicResource InputRowSelectedBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputRowSelectedBorderBrush}" />
    </Style>
    <Style Selector="Border.InputRow.selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource InputRowSelectedHoverBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputRowSelectedHoverBorderBrush}" />
    </Style>
    <Style Selector="Border.InputRow.selection-disabled">
      <Setter Property="Opacity" Value="0.58" />
    </Style>
    <Style Selector="Border.InputRow.selection-disabled:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid>
    <Grid Margin="20">
      <Border IsVisible="{Binding IsProfilesViewActive}"
              BorderBrush="#374151"
              BorderThickness="1"
              CornerRadius="8"
              Background="#0f172a"
              Padding="12">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#e5e7eb"
                       VerticalAlignment="Center"
                       Text="Profiles" />
            <Button Grid.Column="1"
                    Classes="IconButton"
                    ToolTip.Tip="New Profile"
                    automation:AutomationProperties.Name="New Profile"
                    HorizontalAlignment="Right"
                    Click="OnNewProfileClicked">
              <PathIcon Width="16"
                        Height="16"
                        Data="{StaticResource add_square_regular}" />
            </Button>
            <Button Grid.Column="2"
                    Classes="IconButton"
                    ToolTip.Tip="{Binding OpenFileLibraryViewText}"
                    automation:AutomationProperties.Name="{Binding OpenFileLibraryViewText}"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"
                    Click="OnOpenFileLibraryViewClicked">
              <PathIcon Width="16"
                        Height="16"
                        Data="{StaticResource arrow_right_regular}" />
            </Button>
          </Grid>

          <Grid Grid.Row="1"
                x:Name="ProfileListHost"
                Margin="0,12,0,0"
                ClipToBounds="True">
            <ScrollViewer x:Name="ProfileListScrollViewer"
                          Classes="HiddenScrollbars">
              <ItemsControl ItemsSource="{Binding ProfileRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="InputRow"
                            Classes.selected="{Binding IsSelected}"
                            Margin="0,0,0,8"
                            Tag="{Binding Id}"
                            PointerPressed="OnProfileRowPointerPressed"
                            PointerMoved="OnProfileRowPointerMoved"
                            PointerReleased="OnProfileRowPointerReleased"
                            PointerCaptureLost="OnProfileRowPointerCaptureLost">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="6">
                          <TextBlock IsVisible="{Binding IsDisplayVisible}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     MaxLines="2"
                                     TextTrimming="CharacterEllipsis"
                                     Text="{Binding Name}" />
                          <TextBox IsVisible="{Binding IsRenameVisible}"
                                   Tag="{Binding Id}"
                                   Text="{Binding DataContext.SelectedProfileRenameText, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                   KeyDown="OnProfileRenameKeyDown"
                                   LostFocus="OnProfileRenameLostFocus"
                                   Loaded="OnProfileRenameTextBoxLoaded" />
                          <TextBlock IsVisible="{Binding IsCommandPreviewVisible}"
                                     Foreground="#94a3b8"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     Text="{Binding CommandPreviewText}" />
                          <TextBlock IsVisible="{Binding IsInvalidReasonVisible}"
                                     Foreground="#f59e0b"
                                     TextWrapping="Wrap"
                                     Text="{Binding InvalidReason}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="6"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top">
                          <Border IsVisible="{Binding HasStatusBadge}"
                                  Background="{Binding StatusBadgeBackground}"
                                  CornerRadius="999"
                                  Padding="8,2">
                            <TextBlock Foreground="{Binding StatusBadgeForeground}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Text="{Binding StatusBadgeText}" />
                          </Border>
                          <StackPanel Orientation="Horizontal"
                                      Spacing="8"
                                      IsVisible="{Binding IsDisplayVisible}"
                                      HorizontalAlignment="Right">
                            <Button Classes="IconButton"
                                    ToolTip.Tip="Launch"
                                    automation:AutomationProperties.Name="Launch"
                                    Tag="{Binding Id}"
                                    Click="OnLaunchProfileClicked">
                              <PathIcon Width="16"
                                        Height="16"
                                        Data="{StaticResource play_regular}" />
                            </Button>
                            <Button Classes="IconButton"
                                    ToolTip.Tip="Rename"
                                    automation:AutomationProperties.Name="Rename"
                                    Tag="{Binding Id}"
                                    Click="OnRenameProfileClicked">
                              <PathIcon Width="16"
                                        Height="16"
                                        Data="{StaticResource edit_regular}" />
                            </Button>
                            <Button Classes="IconButton"
                                    ToolTip.Tip="Delete"
                                    automation:AutomationProperties.Name="Delete"
                                    Tag="{Binding Id}"
                                    Click="OnDeleteProfileClicked">
                              <PathIcon Width="16"
                                        Height="16"
                                        Data="{StaticResource delete_regular}" />
                            </Button>
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <PathIcon x:Name="ProfileListScrollAffordance"
                      IsHitTestVisible="False"
                      Width="18"
                      Height="18"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Foreground="#80e5e7eb"
                      Opacity="0"
                      Data="{StaticResource arrow_down_regular}">
              <PathIcon.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
              </PathIcon.Transitions>
            </PathIcon>

            <Canvas IsHitTestVisible="False">
              <Border IsVisible="{Binding IsProfileDropIndicatorVisible}"
                      Canvas.Left="{Binding ProfileDropIndicatorLeft}"
                      Canvas.Top="{Binding ProfileDropIndicatorTop}"
                      Width="{Binding ProfileDropIndicatorWidth}"
                      Height="2"
                      Background="#60a5fa" />
              <Border IsVisible="{Binding IsProfileDragGhostVisible}"
                      Canvas.Left="{Binding ProfileDragGhostLeft}"
                      Canvas.Top="{Binding ProfileDragGhostTop}"
                      Background="#111827"
                      BorderBrush="#60a5fa"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12,8"
                      Opacity="0.96">
                <TextBlock Foreground="#e5e7eb"
                           FontWeight="SemiBold"
                           Text="{Binding ProfileDragGhostText}" />
              </Border>
            </Canvas>
          </Grid>
        </Grid>
      </Border>

      <Border IsVisible="{Binding IsFileLibraryViewActive}"
              BorderBrush="#374151"
              BorderThickness="1"
              CornerRadius="8"
              Background="#0f172a"
              Padding="12">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0"
                ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Classes="IconButton"
                    ToolTip.Tip="{Binding ReturnToProfilesViewText}"
                    automation:AutomationProperties.Name="{Binding ReturnToProfilesViewText}"
                    HorizontalAlignment="Left"
                    Click="OnReturnToProfilesViewClicked">
              <PathIcon Width="16"
                        Height="16"
                        Data="{StaticResource arrow_left_regular}" />
            </Button>
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#e5e7eb"
                       VerticalAlignment="Center"
                       Text="File Library" />
          </Grid>

          <Border Grid.Row="1"
                  BorderBrush="#374151"
                  BorderThickness="1"
                  CornerRadius="8"
                  Background="#111827"
                  Padding="12"
                  Margin="0,8,0,0">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <Grid Grid.Column="0">
                  <TextBlock IsVisible="{Binding IsSelectedProfileDisplayVisible}"
                             FontSize="18"
                             FontWeight="Bold"
                             Foreground="#e5e7eb"
                             VerticalAlignment="Center"
                             Text="{Binding SelectedProfileName}" />
                  <TextBox IsVisible="{Binding IsSelectedProfileHeaderRenameVisible}"
                           Tag="{Binding SelectedProfileId}"
                           Text="{Binding SelectedProfileRenameText, Mode=TwoWay}"
                           KeyDown="OnProfileRenameKeyDown"
                           LostFocus="OnProfileRenameLostFocus"
                           Loaded="OnProfileRenameTextBoxLoaded" />
                </Grid>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right">
                  <Button Classes="IconButton"
                          IsVisible="{Binding IsSelectedProfileCreateVisible}"
                          ToolTip.Tip="Create Profile"
                          automation:AutomationProperties.Name="Create Profile"
                          Click="OnNewProfileClicked">
                    <PathIcon Width="16"
                              Height="16"
                              Data="{StaticResource add_square_regular}" />
                  </Button>
                  <Button Classes="IconButton"
                          IsVisible="{Binding HasSelectedProfile}"
                          ToolTip.Tip="Edit"
                          automation:AutomationProperties.Name="Edit"
                          Click="OnEditSelectedProfileClicked">
                    <PathIcon Width="16"
                              Height="16"
                              Data="{StaticResource edit_regular}" />
                  </Button>
                  <Button Classes="IconButton"
                          IsVisible="{Binding HasSelectedProfile}"
                          ToolTip.Tip="Delete"
                          automation:AutomationProperties.Name="Delete"
                          Click="OnDeleteSelectedProfileClicked">
                    <PathIcon Width="16"
                              Height="16"
                              Data="{StaticResource delete_regular}" />
                  </Button>
                </StackPanel>
              </Grid>
              <TextBlock Foreground="{Binding SelectedProfileStatusForeground}"
                         TextWrapping="Wrap"
                         Text="{Binding SelectedProfileStatusText}" />
              <TextBlock IsVisible="{Binding HasSelectedProfileCommandPreview}"
                         Foreground="#94a3b8"
                         FontFamily="Consolas"
                         TextWrapping="Wrap"
                         Text="{Binding SelectedProfileCommandPreviewText}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2"
                Margin="0,12,0,0"
                ClipToBounds="True">
            <ScrollViewer x:Name="FileLibraryScrollViewer"
                          Classes="HiddenScrollbars">
              <StackPanel Spacing="12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="Source Port Inputs" />
                    <Button Grid.Column="1"
                            Classes="IconButton"
                            ToolTip.Tip="{Binding SourcePortSectionToggleText}"
                            automation:AutomationProperties.Name="{Binding SourcePortSectionToggleText}"
                            Click="OnToggleSourcePortSectionCollapsedClicked">
                      <Grid>
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource chevron_up_regular}"
                                  IsVisible="{Binding AreSourcePortRowsVisible}" />
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource chevron_down_regular}"
                                  IsVisible="{Binding IsSourcePortSectionCollapsed}" />
                      </Grid>
                    </Button>
                  </Grid>
                  <Border Classes="DropZone"
                          Classes.dragover="{Binding IsSourcePortDropZoneDragActive}"
                          IsVisible="{Binding AreSourcePortRowsVisible}"
                          Tag="SourcePort"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragEnter="OnDropZoneDragEnter"
                          DragDrop.DragLeave="OnDropZoneDragLeave"
                          DragDrop.DragOver="OnDropZoneDragOver"
                          automation:AutomationProperties.Name="Source Port drop zone. Drag and drop files here."
                          automation:AutomationProperties.HelpText="Allowed: .exe. Directories are ignored."
                          DragDrop.Drop="OnSourcePortDrop">
                    <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                      <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Foreground="{DynamicResource DropZoneTitleForegroundBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Drag and drop here" />
                        <TextBlock Foreground="{DynamicResource DropZoneHelperForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="Allowed: .exe. Directories are ignored." />
                      </StackPanel>
                      <ItemsControl Grid.Row="1"
                                    Margin="0,12,0,0"
                                    ItemsSource="{Binding SourcePortRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="InputRow"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.selection-disabled="{Binding IsSelectionDisabled}"
                                    Margin="0,4,0,0"
                                    Tag="{Binding Path}"
                                    PointerPressed="OnSourcePortRowPointerPressed">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" SharedSizeGroup="SourcePortActionColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="IconButton"
                                        ToolTip.Tip="Delete"
                                        automation:AutomationProperties.Name="Delete"
                                        Tag="{Binding Path}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Click="OnRemoveSourcePortClicked">
                                  <PathIcon Width="16"
                                            Height="16"
                                            Data="{StaticResource delete_regular}" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="IWAD Inputs" />
                    <Button Grid.Column="1"
                            Classes="IconButton"
                            ToolTip.Tip="{Binding IwadSectionToggleText}"
                            automation:AutomationProperties.Name="{Binding IwadSectionToggleText}"
                            Click="OnToggleIwadSectionCollapsedClicked">
                      <Grid>
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource chevron_up_regular}"
                                  IsVisible="{Binding AreIwadRowsVisible}" />
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource chevron_down_regular}"
                                  IsVisible="{Binding IsIwadSectionCollapsed}" />
                      </Grid>
                    </Button>
                  </Grid>
                  <Border Classes="DropZone"
                          Classes.dragover="{Binding IsIwadDropZoneDragActive}"
                          IsVisible="{Binding AreIwadRowsVisible}"
                          Tag="Iwad"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragEnter="OnDropZoneDragEnter"
                          DragDrop.DragLeave="OnDropZoneDragLeave"
                          DragDrop.DragOver="OnDropZoneDragOver"
                          automation:AutomationProperties.Name="IWAD drop zone. Drag and drop files here."
                          automation:AutomationProperties.HelpText="Allowed: .wad, .pk3, .iwad, .ipk3, .ipk7, .pk7. Directories scan top-level files only."
                          DragDrop.Drop="OnIwadDrop">
                    <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                      <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Foreground="{DynamicResource DropZoneTitleForegroundBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Drag and drop here" />
                        <TextBlock Foreground="{DynamicResource DropZoneHelperForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="Allowed: .wad, .pk3, .iwad, .ipk3, .ipk7, .pk7. Directories scan top-level files only." />
                      </StackPanel>
                      <ItemsControl Grid.Row="1"
                                    Margin="0,12,0,0"
                                    ItemsSource="{Binding IwadRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="InputRow"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.selection-disabled="{Binding IsSelectionDisabled}"
                                    Margin="0,4,0,0"
                                    Tag="{Binding Path}"
                                    PointerPressed="OnIwadRowPointerPressed">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" SharedSizeGroup="IwadActionColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="IconButton"
                                        ToolTip.Tip="Delete"
                                        automation:AutomationProperties.Name="Delete"
                                        Tag="{Binding Path}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Click="OnRemoveIwadClicked">
                                  <PathIcon Width="16"
                                            Height="16"
                                            Data="{StaticResource delete_regular}" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </StackPanel>

                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="Mod Inputs" />
                    <Button Grid.Column="1"
                            Classes="IconButton"
                            ToolTip.Tip="{Binding ModSectionToggleText}"
                            automation:AutomationProperties.Name="{Binding ModSectionToggleText}"
                            Click="OnToggleModSectionCollapsedClicked">
                      <Grid>
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource chevron_up_regular}"
                                  IsVisible="{Binding AreModRowsVisible}" />
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource chevron_down_regular}"
                                  IsVisible="{Binding IsModSectionCollapsed}" />
                      </Grid>
                    </Button>
                  </Grid>
                  <Border Classes="DropZone"
                          Classes.dragover="{Binding IsModDropZoneDragActive}"
                          IsVisible="{Binding AreModRowsVisible}"
                          Tag="Mod"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragEnter="OnDropZoneDragEnter"
                          DragDrop.DragLeave="OnDropZoneDragLeave"
                          DragDrop.DragOver="OnDropZoneDragOver"
                          automation:AutomationProperties.Name="Mod drop zone. Drag and drop files here."
                          automation:AutomationProperties.HelpText="Allowed: .wad, .pwad, .pk3, .pk7, .ipk3, .ipk7, .pkz, .zip. Directories scan top-level files only."
                          DragDrop.Drop="OnModDrop">
                    <Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,Auto">
                      <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock Foreground="{DynamicResource DropZoneTitleForegroundBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Drag and drop here" />
                        <TextBlock Foreground="{DynamicResource DropZoneHelperForegroundBrush}"
                                   TextWrapping="Wrap"
                                   Text="Allowed: .wad, .pwad, .pk3, .pk7, .ipk3, .ipk7, .pkz, .zip. Directories scan top-level files only." />
                      </StackPanel>
                      <ItemsControl Grid.Row="1"
                                    Margin="0,12,0,0"
                                    ItemsSource="{Binding ModRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="InputRow"
                                    Classes.selected="{Binding IsSelected}"
                                    Classes.selection-disabled="{Binding IsSelectionDisabled}"
                                    Margin="0,4,0,0"
                                    Tag="{Binding Path}"
                                    PointerPressed="OnModRowPointerPressed">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" SharedSizeGroup="ModActionColumn" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Path}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Classes="IconButton"
                                        ToolTip.Tip="Delete"
                                        automation:AutomationProperties.Name="Delete"
                                        Tag="{Binding Path}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0"
                                        Click="OnRemoveModClicked">
                                  <PathIcon Width="16"
                                            Height="16"
                                            Data="{StaticResource delete_regular}" />
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <PathIcon x:Name="FileLibraryScrollAffordance"
                      IsHitTestVisible="False"
                      ZIndex="1"
                      Width="18"
                      Height="18"
                      Margin="0,0,0,10"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Foreground="#80e5e7eb"
                      Opacity="0"
                      Data="{StaticResource arrow_down_regular}">
              <PathIcon.Transitions>
                <Transitions>
                  <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                </Transitions>
              </PathIcon.Transitions>
            </PathIcon>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="ToastHost"
            IsVisible="{Binding HasToast}"
            ZIndex="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            MaxWidth="420"
            Margin="20"
            Padding="12"
            BorderThickness="1"
            CornerRadius="10"
            Background="{Binding ToastBackground}"
            BorderBrush="{Binding ToastBorderBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   Foreground="{Binding ToastForeground}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Text="{Binding ToastMessageText}" />
        <Button Grid.Column="1"
                Content="Delete"
                IsVisible="{Binding HasToastActions}"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="OnConfirmDeleteProfileClicked" />
        <Button Grid.Column="2"
                Content="Cancel"
                IsVisible="{Binding HasToastActions}"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Click="OnCancelDeleteProfileClicked" />
      </Grid>
    </Border>
  </Grid>
</Window>
